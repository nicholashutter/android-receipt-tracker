<?xml version="1.0" encoding="utf-8"?>
<!--
  Card backgrounds for the verdict panel in EditReceiptActivity.
  Tinted backgrounds with matching border.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/verdict_ok_bg" />
    <stroke
        android:width="1dp"
        android:color="@color/verdict_ok_border" />
    <corners android:radius="16dp" />
</shape>
