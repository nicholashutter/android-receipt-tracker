<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Storage of the full-resolution receipt photo on the device. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".ReceiptTrackerApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ReceiptTracker"
        tools:targetApi="31">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.scan.ScanReceiptActivity"
            android:exported="false" />

        <activity
            android:name=".ui.receipts.ReceiptListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.receipts.EditReceiptActivity"
            android:exported="false" />

        <activity
            android:name=".ui.receipts.CreateReceiptActivity"
            android:exported="false" />

        <activity
            android:name=".ui.transactions.AddTransactionActivity"
            android:exported="false" />

        <activity
            android:name=".ui.transactions.TransactionListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.match.MatchActivity"
            android:exported="false" />

        <activity
            android:name=".ui.export.ExportActivity"
            android:exported="false" />

        <activity
            android:name=".ui.budget.BudgetListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.budget.BudgetDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.debug.LogsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.debug.TestPipelineActivity"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Bundles the Latin on-device text recognition model with the APK
             so we don't need a network download on first use. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="${mlkit_vision_dependency}" />
    </application>
</manifest>
